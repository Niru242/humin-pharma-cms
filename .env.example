# ===== Database (MySQL via LAMPP phpMyAdmin) =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=pharma_hrms
DATABASE_URL="mysql://root:@localhost:3306/pharma_hrms"

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pharma_redis_2024

# ===== MinIO / S3 =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=pharma_minio
MINIO_SECRET_KEY=pharma_minio_secret_2024
MINIO_BUCKET=pharma-hrms-docs
MINIO_USE_SSL=false

# ===== JWT Auth =====
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== Encryption (AES-256-GCM for sensitive fields) =====
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key_here

# ===== App =====
APP_PORT=4000
APP_ENV=development
APP_CORS_ORIGIN=http://localhost:3000

# ===== MFA =====
MFA_ISSUER=PharmaHRMS
